# SPDX-License-Identifier: Apache-2.0
#
# Radiona ULX3S v2.0 (LFE5U-85F-6BG381C) Pin Constraints for Calightra

BLOCK RESETPATHS;
BLOCK ASYNCPATHS;

# 25 MHz Onboard Clock Oscillator
LOCATE COMP "clk_25mhz" SITE "G2";
IOBUF  PORT "clk_25mhz" PULLMODE=NONE IO_TYPE=LVCMOS33;
FREQUENCY PORT "clk_25mhz" 25 MHZ;

# Pushbuttons (Reset)
LOCATE COMP "btn_pwr_n" SITE "D6";
IOBUF  PORT "btn_pwr_n" PULLMODE=UP IO_TYPE=LVCMOS33;
LOCATE COMP "fire1"     SITE "R1";
IOBUF  PORT "fire1"     PULLMODE=DOWN IO_TYPE=LVCMOS33;

# 8 Onboard Status LEDs
LOCATE COMP "led[0]" SITE "B2";
LOCATE COMP "led[1]" SITE "C2";
LOCATE COMP "led[2]" SITE "C1";
LOCATE COMP "led[3]" SITE "D2";
LOCATE COMP "led[4]" SITE "D1";
LOCATE COMP "led[5]" SITE "E2";
LOCATE COMP "led[6]" SITE "E1";
LOCATE COMP "led[7]" SITE "H3";
IOBUF  PORT "led[0]" PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=4;
IOBUF  PORT "led[1]" PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=4;
IOBUF  PORT "led[2]" PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=4;
IOBUF  PORT "led[3]" PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=4;
IOBUF  PORT "led[4]" PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=4;
IOBUF  PORT "led[5]" PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=4;
IOBUF  PORT "led[6]" PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=4;
IOBUF  PORT "led[7]" PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=4;

# FTDI USB-UART (L4 = FPGA TX -> FTDI RX, M1 = FTDI TX -> FPGA RX)
LOCATE COMP "ftdi_rxd" SITE "L4";
IOBUF  PORT "ftdi_rxd" PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=4;
LOCATE COMP "ftdi_txd" SITE "M1";
IOBUF  PORT "ftdi_txd" PULLMODE=UP IO_TYPE=LVCMOS33;

# Onboard ESP32 Control & SPI Host Interface
LOCATE COMP "wifi_en"    SITE "F1";
IOBUF  PORT "wifi_en"    PULLMODE=UP IO_TYPE=LVCMOS33 DRIVE=4;
LOCATE COMP "wifi_gpio0" SITE "L2";
IOBUF  PORT "wifi_gpio0" PULLMODE=UP IO_TYPE=LVCMOS33 DRIVE=4;
LOCATE COMP "esp_sck"    SITE "L1";  # wifi_gpio16
IOBUF  PORT "esp_sck"    PULLMODE=UP IO_TYPE=LVCMOS33;
LOCATE COMP "esp_cs_n"   SITE "N4";  # wifi_gpio5
IOBUF  PORT "esp_cs_n"   PULLMODE=UP IO_TYPE=LVCMOS33;
LOCATE COMP "esp_mosi"   SITE "N3";  # wifi_gpio17
IOBUF  PORT "esp_mosi"   PULLMODE=UP IO_TYPE=LVCMOS33;
LOCATE COMP "esp_miso"   SITE "K1";  # wifi_gpio12
IOBUF  PORT "esp_miso"   PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=4;

# External QSPI PSRAM / Flash on GPIO Header (GP0/GP1, GN0..GN3)
LOCATE COMP "qspi_sck"   SITE "B11"; # gp[0]
IOBUF  PORT "qspi_sck"   PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=4;
LOCATE COMP "qspi_ce_n"  SITE "C11"; # gp[1]
IOBUF  PORT "qspi_ce_n"  PULLMODE=UP IO_TYPE=LVCMOS33 DRIVE=4;
LOCATE COMP "qspi_io[0]" SITE "A10"; # gn[0]
LOCATE COMP "qspi_io[1]" SITE "C10"; # gn[1]
LOCATE COMP "qspi_io[2]" SITE "A9";  # gn[2]
LOCATE COMP "qspi_io[3]" SITE "B9";  # gn[3]
IOBUF  PORT "qspi_io[0]" PULLMODE=UP IO_TYPE=LVCMOS33 DRIVE=4;
IOBUF  PORT "qspi_io[1]" PULLMODE=UP IO_TYPE=LVCMOS33 DRIVE=4;
IOBUF  PORT "qspi_io[2]" PULLMODE=UP IO_TYPE=LVCMOS33 DRIVE=4;
IOBUF  PORT "qspi_io[3]" PULLMODE=UP IO_TYPE=LVCMOS33 DRIVE=4;
